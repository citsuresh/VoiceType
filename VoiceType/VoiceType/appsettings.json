{
  "WhisperStreamExecutablePath": "./whisper.cpp/whisper/Release/whisper-stream.exe",
  "WhisperCliExecutablePath": "./whisper.cpp/whisper/Release/whisper-cli.exe",
  "WhisperServerExecutablePath": "./whisper.cpp/whisper/Release/whisper-server.exe",
  "WhisperServerHost": "127.0.0.1",
  "WhisperServerPort": 51234,
  "WhisperServerArguments": "-bs 8 -bo 8 -mc 0",
  "WhisperServerTimeoutSeconds": 30,
  "WhisperModelPath": "./whisper.cpp/models/ggml-base.en.bin",
  "Mode": "Server",
  "WhisperStreamArguments": "--step 1000 --length 4000 --keep 200 --vad-thold 0.08 -t 4",
  "TempDirectory": "./temp",
  "Language": "en",
  "PreviewChunkMilliseconds": 2000,
  "PreviewThrottleMilliseconds": 1000,
  "PillColor": "#283593",
  "PillOpacity": 0.9,
  "DictationHotkey": "Ctrl+Space",
  "DictationHotkeyEnabled": true,
  "ToggleHotkey": "Ctrl+Shift+Space",
  "ToggleModeEnabled": true,
  "InsertMethod": "Clipboard",
  "EnableClipboardRestore": false,
  "UseTrayIconToggle": true,
  "EnableTranscriptHistory": true,
  "TranscriptHistoryRetentionLimit": 50,
  "CopyToClipboardWhenNoEditable": true,
  "ShowClipboardCopyNotification": true,
  "PostProcessTrimWhitespace": true,
  "PostProcessCollapseSpaces": true,
  "PostProcessCapitalizeSentences": true,
  "RemoveFillerWords": false,
  "FillerWords": [ "um", "uh", "uhm", "er", "erm", "ah", "mm", "mhm", "hmm", "uh-huh", "uh huh", "mm-hmm" ],
  "EnableSpokenPunctuation": true,
  "SpokenPunctuationRules": [
    { "Phrase": "comma", "Replacement": ",", "IsEnabled": true },
    { "Phrase": "period", "Replacement": ".", "IsEnabled": true },
    { "Phrase": "full stop", "Replacement": ".", "IsEnabled": true },
    { "Phrase": "question mark", "Replacement": "?", "IsEnabled": true },
    { "Phrase": "exclamation mark", "Replacement": "!", "IsEnabled": true },
    { "Phrase": "colon", "Replacement": ":", "IsEnabled": true },
    { "Phrase": "semicolon", "Replacement": ";", "IsEnabled": true },
    { "Phrase": "ellipsis", "Replacement": "...", "IsEnabled": true },
    { "Phrase": "hyphen", "Replacement": "-", "IsEnabled": true },
    { "Phrase": "dash", "Replacement": "-", "IsEnabled": true },
    { "Phrase": "quote", "Replacement": "\"", "IsEnabled": true },
    { "Phrase": "open quote", "Replacement": "\"", "IsEnabled": true },
    { "Phrase": "close quote", "Replacement": "\"", "IsEnabled": true },
    { "Phrase": "single quote", "Replacement": "'", "IsEnabled": true },
    { "Phrase": "open parenthesis", "Replacement": "(", "IsEnabled": true },
    { "Phrase": "close parenthesis", "Replacement": ")", "IsEnabled": true },
    { "Phrase": "new line", "Replacement": "<Line break>", "IsEnabled": true },
    { "Phrase": "new paragraph", "Replacement": "<Paragraph break>", "IsEnabled": true },
    { "Phrase": "slash", "Replacement": "/", "IsEnabled": false },
    { "Phrase": "backslash", "Replacement": "\\", "IsEnabled": false },
    { "Phrase": "underscore", "Replacement": "_", "IsEnabled": false },
    { "Phrase": "at sign", "Replacement": "@", "IsEnabled": false },
    { "Phrase": "hash", "Replacement": "#", "IsEnabled": false },
    { "Phrase": "asterisk", "Replacement": "*", "IsEnabled": false },
    { "Phrase": "equals", "Replacement": "=", "IsEnabled": false },
    { "Phrase": "plus", "Replacement": "+", "IsEnabled": false },
    { "Phrase": "open bracket", "Replacement": "[", "IsEnabled": false },
    { "Phrase": "close bracket", "Replacement": "]", "IsEnabled": false },
    { "Phrase": "open brace", "Replacement": "{", "IsEnabled": false },
    { "Phrase": "close brace", "Replacement": "}", "IsEnabled": false }
  ],
  "EnableCustomWordReplacements": true,
  "CustomWordReplacements": [
    { "From": "co pilot", "To": "Copilot", "IsEnabled": true },
    { "From": "copilot", "To": "Copilot", "IsEnabled": true },
    { "From": "copy lot", "To": "Copilot", "IsEnabled": true },
    { "From": "co-pilot", "To": "Copilot", "IsEnabled": true }
  ],
  "EnableCustomRemovalRules": false,
  "CustomRemovalRules": []
}
