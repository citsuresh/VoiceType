<Window x:Class="VoiceType.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceType Settings"
        Height="620" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="480" MinWidth="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Master: search + navigation list -->
            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchTextBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                         VerticalContentAlignment="Center" Padding="4,3"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Filter settings sections" />
                <ListBox x:Name="NavList" DisplayMemberPath="Title"
                         SelectionChanged="NavList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- Detail: hosts the selected section -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,0">
                <ContentControl x:Name="SectionHost" />
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="90" Height="30" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="30" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
