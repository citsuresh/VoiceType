<Window x:Class="VoiceType.UI.CompactOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoiceType.UI.ViewModels"
        Title="CompactOverlayWindow"
        Height="44" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- Pill-shaped container -->
    <Border Background="#E6111118" CornerRadius="22" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
        </Border.Effect>
        <!-- Bars area — horizontally centered, vertically centered in pill -->
        <ItemsControl x:Name="WaveformBars"
                      ItemsSource="{Binding WaveformPoints}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False" Margin="14,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="3" Height="{Binding}" MinHeight="3"
                               Margin="0,0,2,0" RadiusX="1" RadiusY="1"
                               Fill="White" VerticalAlignment="Center" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
