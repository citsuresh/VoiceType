<UserControl x:Class="VoiceType.UI.Settings.Sections.GeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ModelComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="DisplayName" SelectedValuePath="Path" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Microphone" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="MicrophoneComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" DisplayMemberPath="Name" SelectedValuePath="Index" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Language" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="LanguageTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Temp directory" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TempDirectoryTextBox" Grid.Row="3" Grid.Column="1" />
            <Button x:Name="TempDirectoryBrowseButton" Grid.Row="3" Grid.Column="2" Content="Browse..." Margin="8,6,0,6" Padding="8,0" Click="TempDirectoryBrowseButton_Click" />
        </Grid>
    </StackPanel>
</UserControl>
