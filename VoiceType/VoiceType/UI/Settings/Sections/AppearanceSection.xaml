<UserControl x:Class="VoiceType.UI.Settings.Sections.AppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <GroupBox Header="Floating waveform pill">
            <StackPanel>
                <!-- Live preview -->
                <Border x:Name="PreviewBackdrop" Background="#1E1E1E" CornerRadius="8" Padding="16" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                    <Border x:Name="PreviewPill" CornerRadius="22" Height="44" Width="180" HorizontalAlignment="Center">
                        <ItemsControl x:Name="PreviewBars" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="3" Height="{Binding}" MinHeight="3"
                                               Margin="0,0,2,0" RadiusX="1" RadiusY="1"
                                               Fill="White" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Preview background:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Gray" FontSize="11" />
                    <RadioButton x:Name="PreviewBackgroundWhiteRadio" Content="White" GroupName="PreviewBackground"
                                 Margin="0,0,12,0" Checked="PreviewBackgroundRadio_Checked" />
                    <RadioButton x:Name="PreviewBackgroundBlackRadio" Content="Black" GroupName="PreviewBackground"
                                 IsChecked="True" Checked="PreviewBackgroundRadio_Checked" />
                </StackPanel>

                <!-- Color -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pill color" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ColorHexTextBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,6"
                             TextChanged="ColorHexTextBox_TextChanged" />
                    <Border Grid.Column="2" Width="24" Height="24" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1"
                            x:Name="ColorSwatch" Cursor="Hand" MouseLeftButtonUp="ColorSwatch_MouseLeftButtonUp" />
                </Grid>

                <!-- Preset swatches -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Presets:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="Gray" FontSize="11" />
                    <ItemsControl x:Name="PresetSwatches">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Opacity -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Transparency" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" VerticalAlignment="Center"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="2" Width="42" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
