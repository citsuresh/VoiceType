<UserControl x:Class="VoiceType.UI.Settings.Sections.HistorySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Transcript history" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <GroupBox Header="Transcript history">
            <StackPanel>
                <CheckBox x:Name="EnableHistoryCheckBox" Margin="0,6"
                          Content="Keep a local, on-disk history of transcribed text" />

                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Retention limit (entries)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="RetentionLimitTextBox" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                </Grid>

                <TextBlock Margin="20,0,0,6" TextWrapping="Wrap" Foreground="Gray"
                           Text="When enabled, only the most recent entries up to this limit are kept; older entries are dropped automatically. History can be reviewed and cleared from the tray icon's &quot;View Transcript History&quot; menu item, which is hidden while history is disabled." />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
