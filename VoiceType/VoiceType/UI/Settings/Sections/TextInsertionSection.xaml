<UserControl x:Class="VoiceType.UI.Settings.Sections.TextInsertionSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Text insertion" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <GroupBox Header="Text insertion">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Insert method" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="InsertMethodComboBox" Grid.Row="0" Grid.Column="1" />

                    <CheckBox x:Name="EnableClipboardRestoreCheckBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Content="Restore previous clipboard content after paste" />
                </Grid>

                <CheckBox x:Name="CopyToClipboardWhenNoEditableCheckBox" Margin="0,6" Content="Copy to clipboard when no editable field is focused (instead of typing/pasting)" />
                <CheckBox x:Name="ShowClipboardCopyNotificationCheckBox" Margin="20,0,0,6" Content="Show a notification when the transcript is copied to the clipboard" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
