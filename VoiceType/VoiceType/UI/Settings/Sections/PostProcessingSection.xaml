<UserControl x:Class="VoiceType.UI.Settings.Sections.PostProcessingSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="Button" x:Key="ListButton">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Post-processing" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <GroupBox Header="Normalization">
            <StackPanel>
                <CheckBox x:Name="TrimWhitespaceCheckBox" Margin="0,6" Content="Trim leading and trailing whitespace" />
                <CheckBox x:Name="CollapseSpacesCheckBox" Margin="0,6" Content="Collapse repeated spaces" />
                <CheckBox x:Name="CapitalizeSentencesCheckBox" Margin="0,6" Content="Capitalize the start of each sentence" />
                <CheckBox x:Name="AddTrailingPeriodCheckBox" Margin="0,6" Content="Add a trailing period when missing" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Filler words">
            <StackPanel>
                <CheckBox x:Name="RemoveFillerWordsCheckBox" Margin="0,6" Content="Remove filler words"
                          Checked="RemoveFillerWordsCheckBox_Changed" Unchecked="RemoveFillerWordsCheckBox_Changed" />
                <TextBlock Text="Whole-word, case-insensitive. Phrases like &quot;uh-huh&quot; are supported."
                           Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="FillerWordsListBox" Grid.Column="0" Height="140" Margin="0,0,8,0" />

                    <StackPanel Grid.Column="1">
                        <Button x:Name="AddFillerButton" Content="Add" Style="{StaticResource ListButton}" Click="AddFillerButton_Click" />
                        <Button x:Name="EditFillerButton" Content="Edit" Style="{StaticResource ListButton}" Click="EditFillerButton_Click" />
                        <Button x:Name="RemoveFillerButton" Content="Remove" Style="{StaticResource ListButton}" Click="RemoveFillerButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
