<UserControl x:Class="VoiceType.UI.Settings.Sections.DictationSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Dictation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- Hold-to-talk -->
        <GroupBox Header="Hold-to-talk">
            <StackPanel>
                <CheckBox x:Name="DictationHotkeyEnabledCheckBox" Margin="0,6" Content="Enable hold-to-talk hotkey" Checked="DictationHotkeyEnabledCheckBox_CheckedChanged" Unchecked="DictationHotkeyEnabledCheckBox_CheckedChanged" />
                <Grid x:Name="HoldToTalkFieldsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hotkey" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HotkeyCaptureTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" GotFocus="HotkeyCaptureTextBox_GotFocus" LostFocus="HotkeyCaptureTextBox_LostFocus" PreviewKeyDown="HotkeyCaptureTextBox_PreviewKeyDown" />
                    <TextBlock x:Name="HotkeyHintText" Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" Text="Click the box above and press the desired key combination (e.g. Ctrl + Space). Press and hold to dictate; release to stop. Press Esc to cancel." />
                    <TextBlock x:Name="HotkeyValidationText" Grid.Row="1" Grid.Column="1" Foreground="#C00000" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Toggle mode -->
        <GroupBox Header="Toggle mode">
            <StackPanel>
                <CheckBox x:Name="ToggleModeEnabledCheckBox" Margin="0,6" Content="Enable toggle mode" Checked="ToggleModeEnabledCheckBox_CheckedChanged" Unchecked="ToggleModeEnabledCheckBox_CheckedChanged" />
                <StackPanel x:Name="ToggleModeFieldsPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Toggle hotkey" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ToggleHotkeyCaptureTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand" GotFocus="ToggleHotkeyCaptureTextBox_GotFocus" LostFocus="ToggleHotkeyCaptureTextBox_LostFocus" PreviewKeyDown="ToggleHotkeyCaptureTextBox_PreviewKeyDown" />
                        <TextBlock x:Name="ToggleHotkeyHintText" Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" Text="Click the box above and press the desired key combination (e.g. Ctrl + Shift + Space). A single tap starts/stops hands-free dictation. Press Esc to cancel." />
                        <TextBlock x:Name="ToggleHotkeyValidationText" Grid.Row="1" Grid.Column="1" Foreground="#C00000" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed" />
                    </Grid>

                    <CheckBox x:Name="UseTrayIconToggleCheckBox" Margin="0,6" Content="Use tray icon for toggle mode (single-click starts/stops; double-click opens Settings)" />
                    <CheckBox x:Name="ToggleIdleAutoStopCheckBox" Margin="0,6" Content="Automatically stop listening when the mic is idle" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                        <TextBlock Text="Idle timeout (seconds)" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ToggleIdleAutoStopSecondsTextBox" Width="60" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
